# Admin web platform (Vite). Copy to admin/.env.local and fill in from the same
# Supabase project the mobile app points at.
#
# Use the anon/public key here too. NEVER put the service_role key in this file:
# it bypasses row-level security and Vite ships every VITE_* variable to the
# browser. Editorial writes are authorized server side by the publish RPCs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
